(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Push the ball from the green region to the red region in the maze on the table without picking it up)
    (:regions
      (maze_center_region
          (:target kitchen_table)
          (:ranges (
              (-0.20500000000000002 -0.005 -0.195 0.005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ball_start_region
          (:target kitchen_table)
          (:ranges (
              (0.04860000000000003 -0.25060000000000004 0.050600000000000034 -0.24860000000000004)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ball_target_region
          (:target kitchen_table)
          (:ranges (
              (0.02880000000000003 0.22880000000000003 0.07040000000000003 0.27040000000000003)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    maze_structure_1 - maze_structure
    maze_ball_1 - maze_ball
  )

  (:obj_of_interest
    maze_ball_1
  )

  (:init
    (On maze_structure_1 kitchen_table_maze_center_region)
    (On maze_ball_1 kitchen_table_ball_start_region)
  )

  (:goal
    (And (On maze_ball_1 kitchen_table_ball_target_region))
  )

)
