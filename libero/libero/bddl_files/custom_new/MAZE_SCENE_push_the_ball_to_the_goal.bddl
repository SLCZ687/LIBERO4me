(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Push the ball past the rectangular obstacle to the goal)
    (:regions
      (obstacle_center_region
          (:target kitchen_table)
          (:ranges (
              (-0.25500000000000002 -0.005 -0.245 0.005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ball_start_region
          (:target kitchen_table)
          (:ranges (
              (-0.353 0.15100000000000002 -0.351 0.15300000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ball_target_region
          (:target kitchen_table)
          (:ranges (
              (-0.15 -0.25 -0.05 -0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    rectangular_obstacle_1 - rectangular_obstacle
    maze_ball_1 - maze_ball
  )

  (:obj_of_interest
    maze_ball_1
  )

  (:init
    (On rectangular_obstacle_1 kitchen_table_obstacle_center_region)
    (On maze_ball_1 kitchen_table_ball_start_region)
  )

  (:goal
    (And (On maze_ball_1 kitchen_table_ball_target_region))
  )

)
