(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language The tower of hanoi)
    (:regions
      (stand_init_region (:target kitchen_table) (:ranges ((-0.16 0.20 -0.14 0.30))) (:yaw_rotation ((0.0 0.0))))
      (stand_init_region_2 (:target kitchen_table) (:ranges ((-0.16 -0.30 -0.14 -0.20))) (:yaw_rotation ((0.0 0.0))))
      (stand_init_region_3 (:target kitchen_table) (:ranges ((-0.16 -0.05 -0.14 0.05))) (:yaw_rotation ((0.0 0.0))))
      (ring_init_region (:target kitchen_table) (:ranges ((0.0 0.20 0.1 0.3))) (:yaw_rotation ((0.0 0.0))))
      (ring_init_region_2 (:target kitchen_table) (:ranges ((0.0 -0.30 0.1 -0.2))) (:yaw_rotation ((0.0 0.0))))
      (ring_init_region_3 (:target kitchen_table) (:ranges ((0.0 -0.05 0.1 0.05))) (:yaw_rotation ((0.0 0.0))))
      (ring_init_region_4 (:target kitchen_table) (:ranges ((0.0 0.075 0.1 0.175))) (:yaw_rotation ((0.0 0.0))))
      (ring_init_region_5 (:target kitchen_table) (:ranges ((0.0 -0.175 0.1 -0.075))) (:yaw_rotation ((0.0 0.0))))
      (ring_init_region_6 (:target kitchen_table) (:ranges ((0.12 0.10 0.22 0.20))) (:yaw_rotation ((0.0 0.0))))
      (ring_init_region_7 (:target kitchen_table) (:ranges ((0.12 -0.20 0.22 -0.10))) (:yaw_rotation ((0.0 0.0))))
      (ring_target_region (:target kitchen_table) (:ranges ((-0.19 0.06 -0.11 0.14))) (:yaw_rotation ((0.0 0.0))))
    )
  (:fixtures kitchen_table - kitchen_table)
  (:objects
    ring_stand_1 - ring_stand
    ring_stand_2 - ring_stand_two
    ring_stand_3 - ring_stand_three
    torus_ring_1 - torus_ring
    torus_ring_2 - torus_ring_green
    torus_ring_3 - torus_ring_blue
    torus_ring_4 - torus_ring_yellow
    torus_ring_5 - torus_ring_pink
    torus_ring_6 - torus_ring_purple
    torus_ring_7 - torus_ring_orange
  )
  (:obj_of_interest ring_stand_1 ring_stand_2 ring_stand_3 torus_ring_1 torus_ring_2 torus_ring_3 torus_ring_4 torus_ring_5 torus_ring_6 torus_ring_7)

  (:init
    (On ring_stand_1 kitchen_table_stand_init_region)
    (On ring_stand_2 kitchen_table_stand_init_region_2)
    (On ring_stand_3 kitchen_table_stand_init_region_3)
    ;; Stack sequence: Stand -> 7 -> 6 -> 5 -> 4 -> 3 -> 2 -> 1 (Top)
    (On torus_ring_7 ring_stand_1)
    (On torus_ring_6 torus_ring_7)
    (On torus_ring_5 torus_ring_6)
    (On torus_ring_4 torus_ring_5)
    (On torus_ring_3 torus_ring_4)
    (On torus_ring_2 torus_ring_3)
    (On torus_ring_1 torus_ring_2)
  )

  (:goal
    (And 
      ;; Goal sequence: Move whole stack to Stand 2
      (On torus_ring_7 ring_stand_2)
      (On torus_ring_6 torus_ring_7)
      (On torus_ring_5 torus_ring_6)
      (On torus_ring_4 torus_ring_5)
      (On torus_ring_3 torus_ring_4)
      (On torus_ring_2 torus_ring_3)
      (On torus_ring_1 torus_ring_2)
    )
  )
)