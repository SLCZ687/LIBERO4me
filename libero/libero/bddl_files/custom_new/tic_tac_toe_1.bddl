  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    frame_1 - external_frame_tic_tac_toe
    o1 o2  - block_o
    x1 x2 x3  - block_x
  )

  (:obj_of_interest
    o1
    o2 
    x1
    x2
    x3

  )

  (:init
    ;; 将框架固定在中心区域
    (On frame_1 kitchen_table_frame_center_region)
    (On x1 kitchen_table_frame_region_1)
    (On x2 kitchen_table_frame_region_5)
    (On o1 kitchen_table_frame_region_9)
    (On o2 kitchen_table_frame_region_8)
    (On x3 kitchen_table_arbitrary_region)
  )

  (:goal

    (And (On x3 kitchen_table_frame_region_7_target)

    )
  )
)