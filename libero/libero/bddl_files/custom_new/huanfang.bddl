(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the number tiles in the correct positions so that the sum of the numbers in each row and column and diagonal is equal)

  (:regions
    ;; 1. 外部框架放置区域 (固定在桌面中心)
    (frame_center_region
        (:target kitchen_table)
        (:ranges (
            (-0.10001 -0.00001 -0.09999 0.00001)
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )
    
    (block_outside_1
        (:target kitchen_table)
        (:ranges (
            (-0.27 0.2499999 -0.21 0.2500001) ;; x: -0.22 -> -0.27, -0.16 -> -0.21
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_2
        (:target kitchen_table)
        (:ranges (
            (-0.18 0.2499999 -0.12 0.2500001) ;; x: -0.13 -> -0.18, -0.07 -> -0.12
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_3
        (:target kitchen_table)
        (:ranges (
            (-0.09 0.2499999 -0.03 0.2500001) ;; x: -0.04 -> -0.09, 0.02 -> -0.03
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_4
        (:target kitchen_table)
        (:ranges (
            (-0.27 0.3499999 -0.21 0.3500001) ;; x: -0.22 -> -0.27, -0.16 -> -0.21
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_5
        (:target kitchen_table)
        (:ranges (
            (-0.18 0.3499999 -0.12 0.3500001) ;; x: -0.13 -> -0.18, -0.07 -> -0.12
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_6
        (:target kitchen_table)
        (:ranges (
            (-0.09 0.3499999 -0.03 0.3500001) ;; x: -0.04 -> -0.09, 0.02 -> -0.03
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_7
        (:target kitchen_table)
        (:ranges (
            (-0.27 0.4499999 -0.21 0.4500001) ;; x: -0.22 -> -0.27, -0.16 -> -0.21
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_8
        (:target kitchen_table)
        (:ranges (
            (-0.18 0.4499999 -0.12 0.4500001) ;; x: -0.13 -> -0.18, -0.07 -> -0.12
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_9
        (:target kitchen_table)
        (:ranges (
            (-0.09 0.4499999 -0.03 0.4500001) ;; x: -0.04 -> -0.09, 0.02 -> -0.03
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )



    ;; 3. 目标区域 (frame_region_x 保持原位，target 扩大 2.5 倍并保持中心)
    ;; 尺寸从 0.04x0.04 变为 0.1x0.1
    (frame_region_1
        (:target kitchen_table)
        (:ranges ((-0.201 -0.101 -0.199 -0.099)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_1_target
        (:target kitchen_table)
        (:ranges ((-0.25 -0.15 -0.15 -0.05))) ;; 中心 (-0.2, -0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_2
        (:target kitchen_table)
        (:ranges ((-0.201 -0.001 -0.199 0.001)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_2_target
        (:target kitchen_table)
        (:ranges ((-0.25 -0.05 -0.15 0.05)))  ;; 中心 (-0.2, 0.0)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_3
        (:target kitchen_table)
        (:ranges ((-0.201 0.099 -0.199 0.101)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_3_target
        (:target kitchen_table)
        (:ranges ((-0.25 0.05 -0.15 0.15)))   ;; 中心 (-0.2, 0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_4
        (:target kitchen_table)
        (:ranges ((-0.101 -0.101 -0.099 -0.099)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_4_target
        (:target kitchen_table)
        (:ranges ((-0.15 -0.15 -0.05 -0.05))) ;; 中心 (-0.1, -0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_5
        (:target kitchen_table)
        (:ranges ((-0.101 -0.001 -0.099 0.001)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_5_target
        (:target kitchen_table)
        (:ranges ((-0.15 -0.05 -0.05 0.05)))  ;; 中心 (-0.1, 0.0)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_6
        (:target kitchen_table)
        (:ranges ((-0.101 0.099 -0.099 0.101)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_6_target
        (:target kitchen_table)
        (:ranges ((-0.15 0.05 -0.05 0.15)))   ;; 中心 (-0.1, 0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_7
        (:target kitchen_table)
        (:ranges ((-0.001 -0.101 0.001 -0.099)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_7_target
        (:target kitchen_table)
        (:ranges ((-0.05 -0.15 0.05 -0.05)))  ;; 中心 (0.0, -0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_8
        (:target kitchen_table)
        (:ranges ((-0.001 -0.001 0.001 0.001)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_8_target
        (:target kitchen_table)
        (:ranges ((-0.05 -0.05 0.05 0.05)))   ;; 中心 (0.0, 0.0)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_9
        (:target kitchen_table)
        (:ranges ((-0.001 0.099 0.001 0.101)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_9_target
        (:target kitchen_table)
        (:ranges ((-0.05 0.05 0.05 0.15)))    ;; 中心 (0.0, 0.1)
        (:yaw_rotation ((0.0 0.0)))
    )
  )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    ;; 确保这里的类型名与你在 objects.py 注册的一致
    frame_1 - external_frame_huanfang
    n1 - number_block_1
    n2 - number_block_2
    n3 - number_block_3
    n4 - number_block_4
    n5 - number_block_5
    n6 - number_block_6
    n7 - number_block_7
    n8 - number_block_8
    n9 - number_block_9
  )

  (:obj_of_interest
    n1
    n2
    n3
    n4
    n5
    n6
    n7
    n8
    n9
  )

  (:init
    (On frame_1 kitchen_table_frame_center_region)
    ;; 将三个方块初始化在框架外面
    (On n1 kitchen_table_block_outside_1)
    (On n2 kitchen_table_frame_region_1)
    (On n3 kitchen_table_frame_region_6)
    (On n4 kitchen_table_block_outside_4)
    (On n5 kitchen_table_block_outside_5)
    (On n6 kitchen_table_block_outside_6)
    (On n7 kitchen_table_block_outside_7)
    (On n8 kitchen_table_block_outside_8)
    (On n9 kitchen_table_block_outside_9)
  )

  (:goal

        (And (On n5 kitchen_table_frame_region_5_target)
             (On n2 kitchen_table_frame_region_1_target)
             (On n4 kitchen_table_frame_region_3_target)
             (On n6 kitchen_table_frame_region_7_target)
             (On n8 kitchen_table_frame_region_9_target)
             (On n1 kitchen_table_frame_region_8_target)
             (On n3 kitchen_table_frame_region_6_target)
             (On n7 kitchen_table_frame_region_4_target)
             (On n9 kitchen_table_frame_region_2_target)

        
        
        )



    
  )
)
