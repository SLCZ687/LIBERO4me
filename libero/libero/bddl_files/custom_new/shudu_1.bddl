(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the number blocks in the correct positions to ensure that there are no repeating numbers in any row or column)

(:regions
    ;; 1. 外部框架放置区域 (固定在桌面中心)
    ;; 原 Y (0.00) -> 上次 (-0.10) -> 现在: -0.15
    (frame_center_region
        (:target kitchen_table)
        (:ranges (
            (-0.10001 -0.15001 -0.09999 -0.14999)
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )
    
    ;; block_outside 区域: 原本 y ~0.25, 0.35, 0.45
    ;; 减去 0.15 后变为 ~0.10, 0.20, 0.30

    (block_outside_1
        (:target kitchen_table)
        (:ranges (
            (-0.27 0.0999999 -0.21 0.1000001) ;; y: 0.15 -> 0.10
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_2
        (:target kitchen_table)
        (:ranges (
            (-0.18 0.0999999 -0.12 0.1000001) ;; y: 0.15 -> 0.10
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_3
        (:target kitchen_table)
        (:ranges (
            (-0.09 0.0999999 -0.03 0.1000001) ;; y: 0.15 -> 0.10
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_4
        (:target kitchen_table)
        (:ranges (
            (-0.27 0.1999999 -0.21 0.2000001) ;; y: 0.25 -> 0.20
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_5
        (:target kitchen_table)
        (:ranges (
            (-0.18 0.1999999 -0.12 0.2000001) ;; y: 0.25 -> 0.20
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_6
        (:target kitchen_table)
        (:ranges (
            (-0.09 0.1999999 -0.03 0.2000001) ;; y: 0.25 -> 0.20
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_7
        (:target kitchen_table)
        (:ranges (
            (-0.27 0.2999999 -0.21 0.3000001) ;; y: 0.35 -> 0.30
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_8
        (:target kitchen_table)
        (:ranges (
            (-0.18 0.2999999 -0.12 0.3000001) ;; y: 0.35 -> 0.30
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_9
        (:target kitchen_table)
        (:ranges (
            (-0.09 0.2999999 -0.03 0.3000001) ;; y: 0.35 -> 0.30
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )


    ;; 3. 目标区域
    
    ;; frame_region_1
    ;; 原始 Y 中心 -0.1 -> 上次 -0.2 -> 现在 -0.25
    (frame_region_1
        (:target kitchen_table)
        (:ranges ((-0.201 -0.251 -0.199 -0.249)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_1_target
        (:target kitchen_table)
        (:ranges ((-0.25 -0.30 -0.15 -0.20))) 
        (:yaw_rotation ((0.0 0.0)))
    )

    ;; frame_region_2
    ;; 原始 Y 中心 0.0 -> 上次 -0.1 -> 现在 -0.15
    (frame_region_2
        (:target kitchen_table)
        (:ranges ((-0.201 -0.151 -0.199 -0.149)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_2_target
        (:target kitchen_table)
        (:ranges ((-0.25 -0.20 -0.15 -0.10))) 
        (:yaw_rotation ((0.0 0.0)))
    )

    ;; frame_region_3
    ;; 原始 Y 中心 0.1 -> 上次 0.0 -> 现在 -0.05
    (frame_region_3
        (:target kitchen_table)
        (:ranges ((-0.201 -0.051 -0.199 -0.049)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_3_target
        (:target kitchen_table)
        (:ranges ((-0.25 -0.10 -0.15 0.00)))
        (:yaw_rotation ((0.0 0.0)))
    )

    ;; frame_region_4
    ;; 原始 Y 中心 -0.1 -> 上次 -0.2 -> 现在 -0.25
    (frame_region_4
        (:target kitchen_table)
        (:ranges ((-0.101 -0.251 -0.099 -0.249)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_4_target
        (:target kitchen_table)
        (:ranges ((-0.15 -0.30 -0.05 -0.20)))
        (:yaw_rotation ((0.0 0.0)))
    )

    ;; frame_region_5
    ;; 原始 Y 中心 0.0 -> 上次 -0.1 -> 现在 -0.15
    (frame_region_5
        (:target kitchen_table)
        (:ranges ((-0.101 -0.151 -0.099 -0.149)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_5_target
        (:target kitchen_table)
        (:ranges ((-0.15 -0.20 -0.05 -0.10)))
        (:yaw_rotation ((0.0 0.0)))
    )

    ;; frame_region_6
    ;; 原始 Y 中心 0.1 -> 上次 0.0 -> 现在 -0.05
    (frame_region_6
        (:target kitchen_table)
        (:ranges ((-0.101 -0.051 -0.099 -0.049)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_6_target
        (:target kitchen_table)
        (:ranges ((-0.15 -0.10 -0.05 0.00)))
        (:yaw_rotation ((0.0 0.0)))
    )

    ;; frame_region_7
    ;; 原始 Y 中心 -0.1 -> 上次 -0.2 -> 现在 -0.25
    (frame_region_7
        (:target kitchen_table)
        (:ranges ((-0.001 -0.251 0.001 -0.249)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_7_target
        (:target kitchen_table)
        (:ranges ((-0.05 -0.30 0.05 -0.20)))
        (:yaw_rotation ((0.0 0.0)))
    )

    ;; frame_region_8
    ;; 原始 Y 中心 0.0 -> 上次 -0.1 -> 现在 -0.15
    (frame_region_8
        (:target kitchen_table)
        (:ranges ((-0.001 -0.151 0.001 -0.149)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_8_target
        (:target kitchen_table)
        (:ranges ((-0.05 -0.20 0.05 -0.10)))
        (:yaw_rotation ((0.0 0.0)))
    )

    ;; frame_region_9
    ;; 原始 Y 中心 0.1 -> 上次 0.0 -> 现在 -0.05
    (frame_region_9
        (:target kitchen_table)
        (:ranges ((-0.001 -0.051 0.001 -0.049)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_9_target
        (:target kitchen_table)
        (:ranges ((-0.05 -0.10 0.05 0.00)))
        (:yaw_rotation ((0.0 0.0)))
    )
  )
  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    ;; 确保这里的类型名与你在 objects.py 注册的一致
    frame_1 - external_frame_huanfang
    n1_1 n1_2 n1_3 - number_block_1
    n2_1 n2_2 n2_3 - number_block_2
    n3_1 n3_2 n3_3 - number_block_3

  )

  (:obj_of_interest
    n1_1
    n1_2
    n1_3
    n2_1
    n2_2
    n2_3
    n3_1
    n3_2
    n3_3

  )

  (:init
    (On frame_1 kitchen_table_frame_center_region)
    (On n1_1 kitchen_table_frame_region_1)
    (On n2_1 kitchen_table_frame_region_5)
    ;; 将三个方块初始化在框架外面
    (On n1_2 kitchen_table_block_outside_1)
    (On n1_3 kitchen_table_block_outside_2)
    (On n2_2 kitchen_table_block_outside_4)
    (On n2_3 kitchen_table_block_outside_5)
    (On n3_1 kitchen_table_block_outside_7)
    (On n3_2 kitchen_table_block_outside_8)
    (On n3_3 kitchen_table_block_outside_9)

  )

  (:goal

        (And (On n1_2 kitchen_table_frame_region_6_target)
             (On n1_3 kitchen_table_frame_region_8_target)
             (On n2_2 kitchen_table_frame_region_3_target)
             (On n2_3 kitchen_table_frame_region_7_target)
             (On n3_1 kitchen_table_frame_region_2_target)
             (On n3_2 kitchen_table_frame_region_4_target)
             (On n3_3 kitchen_table_frame_region_9_target)
        )
  )
)
