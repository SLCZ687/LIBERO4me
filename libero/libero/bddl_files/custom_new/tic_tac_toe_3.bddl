(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Tic-tac-toe)
  (:regions
    ;; 1. 外部框架放置区域 (固定在桌面中心)
    (frame_center_region
        (:target kitchen_table)
        (:ranges (
            (-0.10001 -0.00001 -0.09999 0.00001)
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )
    
    (block_outside_1
        (:target kitchen_table)
        (:ranges (
            (-0.27 0.2499999 -0.21 0.2500001) ;; x: -0.22 -> -0.27, -0.16 -> -0.21
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_2
        (:target kitchen_table)
        (:ranges (
            (-0.18 0.2499999 -0.12 0.2500001) ;; x: -0.13 -> -0.18, -0.07 -> -0.12
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_3
        (:target kitchen_table)
        (:ranges (
            (-0.09 0.2499999 -0.03 0.2500001) ;; x: -0.04 -> -0.09, 0.02 -> -0.03
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_4
        (:target kitchen_table)
        (:ranges (
            (-0.27 0.3499999 -0.21 0.3500001) ;; x: -0.22 -> -0.27, -0.16 -> -0.21
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_5
        (:target kitchen_table)
        (:ranges (
            (-0.18 0.3499999 -0.12 0.3500001) ;; x: -0.13 -> -0.18, -0.07 -> -0.12
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_6
        (:target kitchen_table)
        (:ranges (
            (-0.09 0.3499999 -0.03 0.3500001) ;; x: -0.04 -> -0.09, 0.02 -> -0.03
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_7
        (:target kitchen_table)
        (:ranges (
            (-0.27 0.4499999 -0.21 0.4500001) ;; x: -0.22 -> -0.27, -0.16 -> -0.21
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_8
        (:target kitchen_table)
        (:ranges (
            (-0.18 0.4499999 -0.12 0.4500001) ;; x: -0.13 -> -0.18, -0.07 -> -0.12
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )

    (block_outside_9
        (:target kitchen_table)
        (:ranges (
            (-0.09 0.4499999 -0.03 0.4500001) ;; x: -0.04 -> -0.09, 0.02 -> -0.03
          )
        )
        (:yaw_rotation ((0.0 0.0)))
    )



    ;; 3. 目标区域 (frame_region_x 保持原位，target 扩大 2.5 倍并保持中心)
    ;; 尺寸从 0.04x0.04 变为 0.1x0.1
    (frame_region_1
        (:target kitchen_table)
        (:ranges ((-0.201 -0.101 -0.199 -0.099)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_1_target
        (:target kitchen_table)
        (:ranges ((-0.25 -0.15 -0.15 -0.05))) ;; 中心 (-0.2, -0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_2
        (:target kitchen_table)
        (:ranges ((-0.201 -0.001 -0.199 0.001)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_2_target
        (:target kitchen_table)
        (:ranges ((-0.25 -0.05 -0.15 0.05)))  ;; 中心 (-0.2, 0.0)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_3
        (:target kitchen_table)
        (:ranges ((-0.201 0.099 -0.199 0.101)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_3_target
        (:target kitchen_table)
        (:ranges ((-0.25 0.05 -0.15 0.15)))   ;; 中心 (-0.2, 0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_4
        (:target kitchen_table)
        (:ranges ((-0.101 -0.101 -0.099 -0.099)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_4_target
        (:target kitchen_table)
        (:ranges ((-0.15 -0.15 -0.05 -0.05))) ;; 中心 (-0.1, -0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_5
        (:target kitchen_table)
        (:ranges ((-0.101 -0.001 -0.099 0.001)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_5_target
        (:target kitchen_table)
        (:ranges ((-0.15 -0.05 -0.05 0.05)))  ;; 中心 (-0.1, 0.0)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_6
        (:target kitchen_table)
        (:ranges ((-0.101 0.099 -0.099 0.101)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_6_target
        (:target kitchen_table)
        (:ranges ((-0.15 0.05 -0.05 0.15)))   ;; 中心 (-0.1, 0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_7
        (:target kitchen_table)
        (:ranges ((-0.001 -0.101 0.001 -0.099)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_7_target
        (:target kitchen_table)
        (:ranges ((-0.05 -0.15 0.05 -0.05)))  ;; 中心 (0.0, -0.1)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_8
        (:target kitchen_table)
        (:ranges ((-0.001 -0.001 0.001 0.001)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_8_target
        (:target kitchen_table)
        (:ranges ((-0.05 -0.05 0.05 0.05)))   ;; 中心 (0.0, 0.0)
        (:yaw_rotation ((0.0 0.0)))
    )

    (frame_region_9
        (:target kitchen_table)
        (:ranges ((-0.001 0.099 0.001 0.101)))
        (:yaw_rotation ((0.0 0.0)))
    )
    (frame_region_9_target
        (:target kitchen_table)
        (:ranges ((-0.05 0.05 0.05 0.15)))    ;; 中心 (0.0, 0.1)
        (:yaw_rotation ((0.0 0.0)))
    )
    (arbitrary_region
        (:target kitchen_table)
        (:ranges (
            (-0.301 -0.050 -0.30 -0.040)
          )
        )
        (:yaw_rotation (
              (0.0 0.0) 
          )       
        )
     )
  )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    frame_1 - external_frame_tic_tac_toe
    o1 o2  - block_o
    x1 x2 x3  - block_x
  )

  (:obj_of_interest
    o1
    o2 
    x1
    x2
    x3

  )

  (:init
    ;; 将框架固定在中心区域
    (On frame_1 kitchen_table_frame_center_region)
    (On x1 kitchen_table_frame_region_3)
    (On x2 kitchen_table_frame_region_9)
    (On o1 kitchen_table_frame_region_5)
    (On o2 kitchen_table_frame_region_6)
    (On x3 kitchen_table_arbitrary_region)
  )

  (:goal

    (And (On x3 kitchen_table_frame_region_4_target)

    )
  )
)