<mujoco model="custom_red_block">
  <asset>
    <!-- 使用你指定的颜色数值：一种更有质感的深红色 -->
    <material name="mat_custom_red" rgba="0.8 0.2 0.2 1" shininess="0.3" specular="0.3"/>
  </asset>
  
  <worldbody>
    <body>
      <body name="object">
        <geom name="num1_geom" type="box" size="0.032 0.032 0.02" material="mat_custom_red" 
              density="1000" friction="0.1 0.005 0.0001" solref="0.002 1" solimp="0.99 0.99 0.001"
              condim="4" group="1"/>
        <!-- 视觉部分也使用同样的材质 -->
        <geom name="num1_vis" type="box" size="0.032 0.032 0.02" material="mat_custom_red" 
              contype="0" conaffinity="0" group="0"/>
        
        <!-- Site 保持不变 -->
        <site name="bottom_site" pos="0 0 -0.02" size="0.002" rgba="0 0 0 0"/>
        <site name="top_site" pos="0 0 0.02" size="0.002" rgba="0 0 0 0"/>
        <site name="horizontal_radius_site" pos="0.032 0 0" size="0.002" rgba="0 0 0 0"/>
      </body>
    </body>
  </worldbody>
</mujoco>